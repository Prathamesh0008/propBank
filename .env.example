# Browser requests use the application's native /api routes.

# Existing browser Firebase project configuration (not Admin credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Auth Admin verifies browser tokens (existing project propbank-7601b).
# Credentials accept inline JSON or a JSON path relative to next-frontend.
# If omitted, ADC must have permission for Auth operations in this project.
FIREBASE_AUTH_PROJECT_ID=
FIREBASE_AUTH_CREDENTIALS=

# Data Admin reads existing Firestore (existing project propbank-944fc).
FIREBASE_DATA_PROJECT_ID=
FIREBASE_DATA_CREDENTIALS=
# Legacy credential/project aliases apply only to DATA, never to Auth.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Configure the existing server GCS bucket only if legacy base64 images require
# it. Never infer it from browser Auth settings or create a replacement bucket.
FIREBASE_DATA_STORAGE_BUCKET=
STORAGE_BUCKET=
FIREBASE_STORAGE_BUCKET=

# Existing R2 account, bucket and public prefix; do not provision replacements.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Reuse Go's existing property email settings for native group 1.
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=
# Absolute authenticated application origin used for email action links.
APP_URL=
# Server-only bearer secret for /api/cron/reminders (minimum 32 characters).
CRON_SECRET=
# Only required if the later auth phase retains legacy JWT issuance.
JWT_SECRET=


# Phase 1: required for NEW uploads. A different, genuinely private R2 bucket.
# Provision and verify deployed permissions separately; never reuse the public bucket.
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=
# Optional ONLY behind an ingress that strips/spoof-proofs this exact header.
# Supported: cf-connecting-ip or x-real-ip. Default: conservative shared anonymous limit.
ENQUIRY_TRUSTED_IP_HEADER=
