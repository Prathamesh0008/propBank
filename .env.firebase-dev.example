# Copy ONLY to .env.firebase-dev.local. Never overwrite .env.local.
# Both developers use the existing shared propbanktest project.
# Obtain its Web app values from Firebase Console; never copy production .env.local.
PROPBANK_FIREBASE_MODE=firebase
FIREBASE_DEV_PROJECT_ID=propbanktest
NEXT_PUBLIC_FIREBASE_PROJECT_ID=propbanktest
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=propbanktest.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_PROJECT_ID=propbanktest
FIREBASE_DATA_PROJECT_ID=propbanktest
FIREBASE_PROJECT_ID=propbanktest
FIRESTORE_DATABASE_ID=(default)
# Same development-only JSON file for both SDKs. Store outside the repository.
# Forward slashes work on Windows; no private keys belong in this file.
FIREBASE_AUTH_CREDENTIALS=C:/Users/YOUR_WINDOWS_USER/.firebase-keys/propbanktest-service-account.json
FIREBASE_DATA_CREDENTIALS=C:/Users/YOUR_WINDOWS_USER/.firebase-keys/propbanktest-service-account.json
APP_URL=http://localhost:8080
