# Optional: copy to .env.test-accounts.local ONLY if that file does not exist.
# npm run dev:emulator works with these defaults without a local emulator file.
FIREBASE_TEST_PROJECT_ID=demo-propbank
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-propbank
FIREBASE_AUTH_PROJECT_ID=demo-propbank
FIREBASE_DATA_PROJECT_ID=demo-propbank
FIREBASE_PROJECT_ID=demo-propbank
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=demo-emulator-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-propbank.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-propbank-local
PROPBANK_TEST_PREFIX=PBDEV_AUTH_LOCAL_001
