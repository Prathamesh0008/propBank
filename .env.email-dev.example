# Optional local-only email settings. Copy to .env.email-dev.local if absent.
# Keys/recipients belong ONLY in the gitignored .local file, never this template.
PROPBANK_EMAIL_MODE=capture
# To opt in: resend-test + an explicit development key, verified sender confirmation
# and 1-5 comma-separated exact developer-controlled recipients (no wildcards).
RESEND_API_KEY=
FROM_EMAIL=connect@propbank.care
PROPBANK_EMAIL_SENDER_VERIFIED=
PROPBANK_EMAIL_ALLOWLIST=
# Set to an allowlisted development inbox for admin notifications; blank disables them.
ADMIN_EMAIL=
